#!/bin/sh
# TB-X606F mainline initramfs /init
#
# Rootfs layout (standard MTK mainline porting):
#   1. eMMC userdata  = /dev/mmcblk0p38   <- primary, flashed with the Debian
#                                            ext4 image via fastboot
#   2. microSD        = /dev/mmcblk1pN    <- fallback / alternative carrier
#   3. anything else on eMMC that looks like a rootfs
# If nothing matches: emergency shell on ttyS0 (POGO UART) / ttyGS0 (USB
# gadget serial) so a blind bring-up still has a way to see what happened.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /run /var/log

echo "=========================================="
echo " TB-X606F mainline initramfs"
echo " kernel: $(uname -r)"
echo "=========================================="

# Load any modules shipped in the initramfs (kernel is mostly built-in).
if [ -d /lib/modules ]; then
    for f in /lib/modules/*/modules.dep; do
        [ -e "$f" ] && break
        depmod -a "$(dirname "$(dirname "$f")")" 2>/dev/null
    done
fi

# pstore: surface logs from a previous panic (blind-debug path)
if [ -d /sys/fs/pstore ]; then
    mkdir -p /pstore
    mount -t pstore pstore /pstore 2>/dev/null && {
        echo "--- pstore records from previous boot ---"
        ls -la /pstore
        cat /pstore/dmesg-ramoops-0 2>/dev/null | tail -100
        echo "--- end pstore ---"
    }
fi

# usrmerge-aware: Debian trixie has sbin->usr/sbin and init under
# /usr/lib/systemd/systemd, so checking only /sbin/init can be misleading
# depending on how the rootfs was extracted.
is_rootfs() {
    local d="$1"
    [ -d "$d/etc" ] || return 1
    for c in /sbin/init /usr/sbin/init /usr/lib/systemd/systemd /lib/systemd/systemd; do
        [ -e "$d$c" ] && return 0
    done
    return 1
}

ROOTDEV=""
ROOTFS=""
mkdir -p /mnt/rootfs

try_mount() {
    local dev="$1" cands="$2" fs
    [ -b "$dev" ] || return 1
    for fs in $cands; do
        if mount -t "$fs" -o rw "$dev" /mnt/rootfs 2>/dev/null; then
            if is_rootfs /mnt/rootfs; then
                ROOTDEV="$dev"; ROOTFS="$fs"; return 0
            fi
            echo "  $dev ($fs): mounted but no init, skipping"
            umount /mnt/rootfs 2>/dev/null
        fi
    done
    return 1
}

echo "Scanning for rootfs..."

# 1) eMMC userdata -- primary target (fastboot flash userdata rootfs.img)
try_mount /dev/mmcblk0p38 "ext4 ext2"

# 2) microSD card -- fallback carrier
if [ -z "$ROOTDEV" ]; then
    for p in 1 2 3; do
        try_mount "/dev/mmcblk1p$p" "ext4 ext2 vfat" && break
    done
fi

# 3) last resort: anything on eMMC that looks like a rootfs
if [ -z "$ROOTDEV" ]; then
    for p in 1 37 39 40; do
        try_mount "/dev/mmcblk0p$p" "ext4 ext2" && break
    done
fi

if [ -n "$ROOTDEV" ]; then
    echo "rootfs: $ROOTDEV ($ROOTFS) -> switch_root"
    mkdir -p /mnt/rootfs/proc /mnt/rootfs/sys /mnt/rootfs/dev /mnt/rootfs/run
    mount -t proc     proc     /mnt/rootfs/proc
    mount -t sysfs    sysfs    /mnt/rootfs/sys
    mount -t devtmpfs devtmpfs /mnt/rootfs/dev
    # keep the pstore record reachable from the real root as well
    mkdir -p /mnt/rootfs/pstore 2>/dev/null
    exec switch_root /mnt/rootfs /sbin/init
fi

# ---- emergency shell (first boot lands here) ----
echo "No rootfs found."
echo "Emergency shell on console (ttyS0 / ttyGS0)."
echo "Block devices seen:"
ls /dev/mmcblk* /dev/sd* 2>/dev/null || echo "  (none!)"
echo "Hints:"
echo "  mount -t ext4 /dev/mmcblk0p38 /mnt && ls /mnt"
echo "  i2cdetect -y -r 5          # scan i2c bus 5 (PMIC/subPMIC)"
echo "  cat /proc/interrupts       # is anything alive?"
echo ""
exec setsid cttyhack sh
exit 0
